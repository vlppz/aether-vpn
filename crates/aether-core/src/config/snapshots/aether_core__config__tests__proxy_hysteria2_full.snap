---
source: crates/aether-core/src/config/tests.rs
expression: config
---
{
  "dns": {
    "queryStrategy": "UseIPv4",
    "servers": [
      "https://1.1.1.1/dns-query",
      {
        "address": "77.88.8.8",
        "domains": [
          "geosite:private",
          "geosite:category-ru"
        ],
        "skipFallback": true
      }
    ]
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 11808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "enabled": true
      },
      "tag": "socks-in"
    },
    {
      "listen": "127.0.0.1",
      "port": 11809,
      "protocol": "http",
      "settings": {},
      "sniffing": {
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "enabled": true
      },
      "tag": "http-in"
    }
  ],
  "log": {
    "dnsLog": false,
    "loglevel": "warning"
  },
  "metrics": {
    "listen": "127.0.0.1:11813",
    "tag": "metrics"
  },
  "outbounds": [
    {
      "protocol": "hysteria",
      "settings": {
        "address": "hy.example.com",
        "port": 443,
        "version": 2
      },
      "streamSettings": {
        "finalmask": {
          "quicParams": {
            "brutalDown": "200 mbps",
            "brutalUp": "50 mbps",
            "congestion": "brutal",
            "udpHop": {
              "interval": 30,
              "ports": "20000-30000"
            }
          },
          "udp": [
            {
              "settings": {
                "password": "gawr"
              },
              "type": "salamander"
            }
          ]
        },
        "hysteriaSettings": {
          "auth": "letmein",
          "version": 2
        },
        "network": "hysteria",
        "security": "tls",
        "tlsSettings": {
          "alpn": [
            "h3"
          ],
          "serverName": "hy.example.com"
        }
      },
      "tag": "proxy"
    },
    {
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4"
      },
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    }
  ],
  "policy": {
    "system": {
      "statsOutboundDownlink": true,
      "statsOutboundUplink": true
    }
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "ip": [
          "77.88.8.8"
        ],
        "outboundTag": "direct",
        "port": "53"
      },
      {
        "domain": [
          "geosite:category-ads-all"
        ],
        "outboundTag": "block"
      },
      {
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "direct"
      },
      {
        "domain": [
          "geosite:private"
        ],
        "outboundTag": "direct"
      },
      {
        "domain": [
          "geosite:category-ru"
        ],
        "outboundTag": "direct"
      },
      {
        "ip": [
          "geoip:ru"
        ],
        "outboundTag": "direct"
      }
    ]
  },
  "stats": {}
}
