{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether",
  "version": "0.1.0",
  "identifier": "app.aether.vpn",
  "build": {
    "beforeDevCommand": "node ../scripts/prepare-sidecars.mjs && pnpm dev",
    "beforeBuildCommand": "node ../scripts/prepare-sidecars.mjs --release && pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Aether",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Fast Xray-core VPN client",
    "longDescription": "Aether is a fast, good-looking VPN client for Xray-core with subscriptions, smart routing, system proxy and TUN modes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/xray", "binaries/aether-helper"],
    "resources": {
      "resources/geoip.dat": "geoip.dat",
      "resources/geosite.dat": "geosite.dat"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["aether"] }
    }
  }
}
